# ==============================================================================
# SynthaBasket Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit .env.local to version control.
# ==============================================================================

# Solana Cluster RPC Endpoint
# Prefer SOLANA_DEVNET_RPC_URL for server-side hydration if your RPC URL contains a key.
SOLANA_DEVNET_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_NETWORK=devnet

# Optional mainnet RPC used only to inspect canonical provider mints for verified
# Markets-page Jupiter liquidity probes.
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Anchor Vault Program ID used by the verified Devnet execution path
NEXT_PUBLIC_PROGRAM_ID=4BLhUEXXqBBuciecSaVEo41NrXeDGGNhNLdfLmoeqstA

# Optional server-side override for the official STOCKLANA Tessera Product API.
# Default: https://rest-api.tessera.pe/v1/public/token-details
TESSERA_API_URL=

# Optional Pyth Pro API key for authenticated Pro REST reads.
# OpenAI / Anthropic Pyth Index symbols are shown as references when a value
# can be resolved. If no supported API value is returned, the UI displays —.
PYTH_PRO_API_KEY=
# Backward-compatible alias accepted by the app if already configured:
# PYTH_INDEX_API_KEY=

# Jupiter Swap API V2
JUPITER_API_KEY=

# Durable NAV + market observation history (Upstash REST endpoint + token)
# REST URL must look like https://<database>.upstash.io, not redis://...
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Runner private key (JSON array or Base58) for executing test scripts
# RUNNER_PRIVATE_KEY=

# ==============================================================================
# Devnet mirror execution (explicit test-only acquisition path)
# ==============================================================================
DEVNET_MIRROR_AUTHORITY_SECRET=

NEXT_PUBLIC_DEVNET_MIRROR_T_OPENAI=
NEXT_PUBLIC_DEVNET_MIRROR_ANTHROPIC=
NEXT_PUBLIC_DEVNET_MIRROR_T_KALSHI=
NEXT_PUBLIC_DEVNET_MIRROR_T_SPACEX=
NEXT_PUBLIC_DEVNET_MIRROR_ANDURIL=
NEXT_PUBLIC_DEVNET_MIRROR_KALSHI=
NEXT_PUBLIC_DEVNET_MIRROR_POLYMARKET=
NEXT_PUBLIC_DEVNET_MIRROR_OPENAI=
NEXT_PUBLIC_DEVNET_MIRROR_NEURALINK=
NEXT_PUBLIC_DEVNET_MIRROR_FIGUREAI=
