# ==============================================================================
# SynthaBasket Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit .env.local to version control.
# ==============================================================================

# Solana Cluster RPC Endpoint
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_NETWORK=devnet

# Anchor Vault Program ID (Verified on Solana Devnet)
NEXT_PUBLIC_PROGRAM_ID=BKmpdn4owi7ktwt1Brn5v9fZkRv15wBSdJXGUYAU5gBh

# Pyth Hermes Price Service (Authenticated Access)
# Obtain from https://hermes.pyth.network
PYTH_API_KEY=

# Jupiter Swap API V2
# Obtain from https://jup.ag
JUPITER_API_KEY=

# Optional: Runner private key (JSON array or Base58) for executing test scripts
# RUNNER_PRIVATE_KEY=


# ==============================================================================
# Devnet mirror execution (explicit test-only acquisition path)
# ==============================================================================
# Server-side mint authority for the Devnet mirror assets. NEVER expose publicly.
DEVNET_MIRROR_AUTHORITY_SECRET=

# Public Devnet mirror mint addresses created by scripts/provision-devnet-mirrors.ts
NEXT_PUBLIC_DEVNET_MIRROR_T_OPENAI=
NEXT_PUBLIC_DEVNET_MIRROR_ANTHROPIC=
NEXT_PUBLIC_DEVNET_MIRROR_T_KALSHI=
NEXT_PUBLIC_DEVNET_MIRROR_T_SPACEX=
NEXT_PUBLIC_DEVNET_MIRROR_ANDURIL=
NEXT_PUBLIC_DEVNET_MIRROR_KALSHI=
NEXT_PUBLIC_DEVNET_MIRROR_POLYMARKET=
NEXT_PUBLIC_DEVNET_MIRROR_OPENAI=
NEXT_PUBLIC_DEVNET_MIRROR_NEURALINK=
NEXT_PUBLIC_DEVNET_MIRROR_FIGUREAI=
